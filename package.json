{
  "name": "emeeek-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Emeek — 基于 GitHub Issues 的下一代个人知识宇宙引擎",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/cli/bin/emeeek.js build --cwd examples/minimal",
    "dev": "node packages/cli/bin/emeeek.js dev --cwd examples/minimal",
    "test": "node --test \"packages/core/tests/**/*.test.js\" \"packages/cli/tests/*.test.js\"",
    "coverage": "node --experimental-test-coverage --test \"packages/core/tests/**/*.test.js\" \"packages/cli/tests/*.test.js\"",
    "lighthouse": "node scripts/lighthouse.mjs",
    "doctor": "node packages/cli/bin/emeeek.js doctor --cwd examples/minimal",
    "benchmark": "node scripts/ai-benchmark.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
