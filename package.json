{
  "name": "emeeek-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Emeek — 基于 GitHub Issues 的下一代个人知识宇宙引擎",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/cli/bin/emeeek.js build --cwd examples/minimal",
    "dev": "node packages/cli/bin/emeeek.js dev --cwd examples/minimal",
    "test": "node --test \"packages/core/tests/**/*.test.js\" \"packages/cli/tests/*.test.js\" \"packages/editor/tests/*.test.js\"",
    "coverage": "node --experimental-test-coverage --test \"packages/core/tests/**/*.test.js\" \"packages/cli/tests/*.test.js\" \"packages/editor/tests/*.test.js\"",
    "lighthouse": "node scripts/lighthouse.mjs",
    "doctor": "node packages/cli/bin/emeeek.js doctor --cwd examples/minimal",
    "benchmark": "node scripts/ai-benchmark.mjs && node packages/editor/tests/bench/preview-bench.mjs",
    "benchmark:preview": "node packages/editor/tests/bench/preview-bench.mjs",
    "studio": "node packages/cli/bin/emeeek.js studio --cwd examples/minimal",
    "check:studio-bundle": "node scripts/check-studio-bundle.mjs",
    "test:e2e": "node scripts/e2e/xss.mjs && node scripts/e2e/draft-mobile.mjs && node scripts/e2e/dev-integration.mjs && node scripts/e2e/ai-panel.mjs",
    "test:negative": "bash scripts/e2e/negative-check.sh",
    "check:shortcuts": "node scripts/check-shortcuts.mjs",
    "test:perf": "node scripts/lighthouse.mjs",
    "screenshots:themes": "node scripts/screenshots/capture.mjs",
    "preview:themes": "node scripts/preview-images.mjs",
    "lighthouse:themes": "node scripts/lighthouse-themes.mjs",
    "e2e:theme": "node scripts/e2e/theme.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@emeeek/core": "workspace:*",
    "@emeeek/editor": "workspace:*"
  }
}
