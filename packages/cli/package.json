{
  "name": "emeeek",
  "version": "1.0.0",
  "description": "Emeek —— 用 GitHub Issues 或 Markdown 写文章、一条命令构建、零成本部署的静态知识站引擎",
  "type": "module",
  "bin": {
    "emeeek": "./bin/emeeek.js"
  },
  "main": "./src/index.js",
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@emeeek/core": "workspace:^1.0.0",
    "@emeeek/editor": "workspace:^1.0.0"
  },
  "license": "MIT",
  "keywords": [
    "static-site-generator",
    "blog",
    "markdown",
    "github-issues",
    "cms",
    "ssg",
    "zero-dependency",
    "中文",
    "pwa",
    "seo"
  ],
  "homepage": "https://github.com/techjiang/emeek#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techjiang/emeek.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/techjiang/emeek/issues"
  },
  "author": {
    "name": "科技酱",
    "url": "https://github.com/techjiang"
  },
  "publishConfig": {
    "access": "public"
  }
}
